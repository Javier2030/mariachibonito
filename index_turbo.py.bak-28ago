# Permite correr el turbo para un solo sitio:  index_turbo.py mariachiestrellamexicana
ONLY = (sys.argv[1] if len(sys.argv) > 1 else "").strip().lower()
if ONLY:
    SITES = [x for x in SITES if ONLY in x["domain"]]


def fix_interop():
    import glob
    def ps_ok():
        try:
            r = subprocess.run([PS, "-NoProfile", "-Command", "echo ok"],
                               capture_output=True, text=True, timeout=15)
            return "ok" in (r.stdout or "")
        except Exception:
            return False
    if ps_ok():
        return True
    for s in sorted(glob.glob("/run/WSL/*_interop")):
        os.environ["WSL_INTEROP"] = s
        if ps_ok():
            return True
    return False


def cdp_alive():
    r = subprocess.run([PS, "-NoProfile", "-Command",
                        "(Invoke-WebRequest 'http://127.0.0.1:9333/json/version' -UseBasicParsing -TimeoutSec 5).StatusCode"],
                       capture_output=True, text=True, errors="replace", timeout=30)
    return "200" in (r.stdout or "")


def launch_edge():
    subprocess.run([PS, "-NoProfile", "-Command",
                    f"Start-Process -FilePath '{EDGE}' -ArgumentList "
                    "'--remote-debugging-port=9333','--user-data-dir=C:\\temp\\edge_cdp','--no-first-run',"
                    "'--disable-background-timer-throttling','about:blank'"],
                   capture_output=True, text=True, timeout=30)
    time.sleep(12)


def tabs_json():
    r = subprocess.run([PS, "-NoProfile", "-Command",
                        "(Invoke-WebRequest 'http://127.0.0.1:9333/json' -UseBasicParsing -TimeoutSec 10).Content"],
                       capture_output=True, text=True, errors="replace", timeout=30)
    return r.stdout or ""


def fresh_gsc_tab(resource, authuser=0):
    """Cierra pestanas GSC viejas (la SPA degenera con horas abierta: el submit
    de la barra deja de responder) y abre una nueva directo en la propiedad."""
    import json as _j
    try:
        tabs = _j.loads(tabs_json())
    except Exception:
        tabs = []
    for t in tabs:
        if "search-console" in t.get("url", ""):
            subprocess.run([PS, "-NoProfile", "-Command",
                            f"try{{Invoke-WebRequest 'http://127.0.0.1:9333/json/close/{t['id']}' -UseBasicParsing -TimeoutSec 10 | Out-Null}}catch{{}}"],
                           capture_output=True, text=True, timeout=30)
    url = f"https://search.google.com/u/{authuser}/search-console?resource_id={resource}"
    for method in ("Put", "Get"):
        subprocess.run([PS, "-NoProfile", "-Command",
                        f"try{{Invoke-WebRequest 'http://127.0.0.1:9333/json/new?{url}' "
                        f"-Method {method} -UseBasicParsing -TimeoutSec 10 | Out-Null}}catch{{}}"],
                       capture_output=True, text=True, timeout=30)
        time.sleep(9)
        if "search-console" in tabs_json():
            return True
    return False


def tg(text):
    tok = chat = None
    try:
        for ln in open(ENV_TG):
            if ln.startswith("TG_TOKEN="): tok = ln.split("=", 1)[1].strip()
            if ln.startswith("TG_CHAT="): chat = ln.split("=", 1)[1].strip()
    except Exception:
        pass
    if not tok or not chat:
        print("(sin TG)\n" + text); return
    try:
        # sin parse_mode: el resumen lleva URLs y símbolos (<, &, _) que Telegram
        # rechaza con HTTP 400 al intentar interpretarlos como marcado (fallo 23-jul)
        d = json.dumps({"chat_id": chat, "text": text,
                        "disable_web_page_preview": True}).encode()
        urllib.request.urlopen(urllib.request.Request(
            f"https://api.telegram.org/bot{tok}/sendMessage", data=d,
            headers={"Content-Type": "application/json"}), timeout=10)
    except Exception as e:
        print("TG fail:", e)


def por_prioridad(pending, patrones):
    """Ordena los pendientes por valor de negocio en vez de alfabéticamente.

    La cuota de «Solicitar indexación» es de ~12-14 por cuenta y día: con cientos de páginas
    pendientes, el orden alfabético gasta el presupuesto del día en lo que empiece por «a».
    `patrones` es una lista ordenada de subcadenas; lo que casa con la primera va primero.
    Lo que no casa con ninguna se pide al final, pero NO se descarta.
    """
    if not patrones:
        return pending
    def rango(u):
        for i, pat in enumerate(patrones):
            if pat in u:
                return i
        return len(patrones)
    return sorted(pending, key=rango)   # sorted es estable: dentro del grupo, orden original


def sitemap_urls(domain):
    # resiliente: si el cert HTTPS falla (propagación GitHub Pages), reintenta sin verificar y luego HTTP
    import ssl
    for url, ctx in ((f"https://{domain}/sitemap.xml", None),
                     (f"https://{domain}/sitemap.xml", ssl._create_unverified_context()),
                     (f"http://{domain}/sitemap.xml", None)):
        try:
            sm = urllib.request.urlopen(url, timeout=20, context=ctx).read().decode()
            locs = re.findall(r"<loc>(.*?)</loc>", sm)
            if locs:
                return locs
        except Exception:
            continue
    raise RuntimeError("sitemap inaccesible por todas las vías")


def ps_run(script, args, timeout):
    r = subprocess.run([PS, "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", script] + args,
                       capture_output=True, text=True, errors="replace", timeout=timeout)
    return r.stdout or ""





def hist_indexed(site):
    """URLs indexadas SEGÚN LA ÚLTIMA MEDICIÓN del vigía site:.

    FIX 2026-08-05: antes devolvía la UNIÓN con `urls_union_seen` (acumulado histórico),
    así que una URL que estuvo indexada una vez y luego SE CAYÓ del índice contaba como
    indexada para siempre y no se volvía a pedir jamás. Efecto medido en mariachibonito:
    index_watch decía 76/91 e index_turbo se declaraba «sin pendientes, 91/91» — 5 páginas
    caídas del índice quedaban abandonadas (canciones-para-bodas, mariachis-la-mesa,
    primera-comunion, despecho, misa-ranchera).
    Ahora manda el estado ACTUAL. El ruido de las consultas site: (una URL que un día no
    aparece y al siguiente sí) ya está acotado por REQ_TTL_DAYS: como mucho cuesta una
    solicitud por semana y por URL, mucho más barato que abandonarla."""
    try:
        h = json.load(open(site["hist"]))
        paths = set(h.get("urls", []) or [])
        return {f"https://{site['domain']}{p}" for p in paths}
    except Exception:
        return set()


def main():
    print(f"== index_turbo {time.strftime('%Y-%m-%d %H:%M:%S')} ==")
    if not fix_interop():
        print("interop muerto"); return
    if not cdp_alive():
        launch_edge()
        if not cdp_alive():
            tg("⚡ index_turbo: no pude levantar Edge CDP 9333."); return


    st = {}
    if os.path.exists(STATE):
        try: st = json.load(open(STATE))
        except Exception: st = {}

    today = time.strftime("%Y-%m-%d")
    lines = []
    for site in SITES:
        d = site["domain"]
        s = st.setdefault(d, {"indexed_confirmed": [], "requested": {}})
        try:
            urls = sitemap_urls(d)
        except Exception as e:
            lines.append(f"• {d}: sitemap inaccesible ({e})"); continue
        indexed = set(s["indexed_confirmed"]) | hist_indexed(site)
        recent = {u for u, day in s["requested"].items()
                  if (time.mktime(time.strptime(today, "%Y-%m-%d")) -
                      time.mktime(time.strptime(day, "%Y-%m-%d"))) < REQ_TTL_DAYS * 86400}
        pending = [u for u in urls if u not in indexed and u not in recent]
        # 25-ago: la lista `prioridad` del sitio existía pero nunca se aplicaba — `pending`
        # salía en el orden del sitemap (alfabético) y la cuota se iba en las «a».
        pending = por_prioridad(pending, site.get("prioridad"))
        if not pending:
            n_idx = len([u for u in urls if u in indexed])
            lines.append(f"• {d}: sin pendientes (indexadas conocidas {n_idx}/{len(urls)}, resto ya solicitado <7d)")
            continue
        req = conf = 0
        quota_final = False
        for au in site.get("authusers", AUTHUSERS):
            if not fresh_gsc_tab(site["resource"], au):
                lines.append(f"• {d}: no pude abrir pestaña GSC (authuser {au})"); continue
            procesadas = 0
            fails = 0
            quota = False
            for u in [x for x in pending if x not in s["requested"] and x not in s["indexed_confirmed"]]:
                if req >= MAX_REQ or quota:
                    break
                if procesadas and procesadas % 5 == 0:
                    fresh_gsc_tab(site["resource"], au)
                procesadas += 1
                try:
                    out = ps_run(r"C:\temp\gsc_turbo.ps1", ["-Target", u], 420)
                except subprocess.TimeoutExpired:
                    print(f"  timeout {u}"); continue
                if fails >= 3:
                    print(f"  3 fallos seguidos con authuser {au}: salto de cuenta"); break
                if "ESTADO=INDEXADA" in out:
                    if u not in s["indexed_confirmed"]:
                        s["indexed_confirmed"].append(u)
                    conf += 1
                    fails = 0
                    print(f"  ya indexada: {u}")
                elif "SOLICITADA=True" in out:
                    s["requested"][u] = today
                    req += 1
                    fails = 0
                    print(f"  solicitada: {u} (authuser {au})")
                elif "CUOTA_AGOTADA" in out:
                    quota = True
                    print(f"  cuota agotada (authuser {au})")
                else:
                    fails += 1
                    print(f"  fallo: {u} :: {out.strip()[:160]}")
                json.dump(st, open(STATE, "w"), ensure_ascii=False, indent=1)
                time.sleep(5)
            quota_final = quota
            if not quota:
                break  # pendientes agotados o tope alcanzado sin cuota: no hace falta otra cuenta
        n_idx = len(set(s['indexed_confirmed']) | hist_indexed(site))
        extra = " (CUOTA AGOTADA)" if quota_final else ""
        lines.append(f"• {d}: {req} solicitadas hoy, {conf} confirmadas ya-indexadas, "
                     f"{n_idx}/{len(urls)} en índice{extra}")

    json.dump(st, open(STATE, "w"), ensure_ascii=False, indent=1)
    tg("⚡ <b>INDEX TURBO diario</b>\n\n" + "\n".join(lines) +
       "\n\nSigo a diario hasta indexar el 100% de los 3 sitios.")
    print("\n".join(lines))


if __name__ == "__main__":
    main()
